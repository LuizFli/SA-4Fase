  "description": "",
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node": "^22.21.0",
    "nodemailer": "^6.9.4",
    "pdfkit": "^0.13.0",
    "prisma": "^5.12.0",
    "dotenv": "^16.1.4",
    "sa-backend": "file:",
    "socket.io": "^4.7.2"
  }
}
