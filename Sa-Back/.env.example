# Prisma database connection string
# For local MySQL (host-port 3306 from Docker or local install):
DATABASE_URL="mysql://root:senai@localhost:3306/authdb"

# JWT secrets (dev-safe defaults; change in prod)
ACCESS_TOKEN_SECRET="dev_access_secret"
REFRESH_TOKEN_SECRET="dev_refresh_secret"

# Token TTLs (jsonwebtoken formats supported)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="8h"
